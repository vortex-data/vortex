+namespace {
+template <typename T>
+auto host_values(cudf::column_view column, cuda::stream_ref stream)
+{
+  CUDF_EXPECTS(column.type() == cudf::data_type{cudf::type_to_id<T>()} && !column.has_nulls(),
+               "Unexpected generated type or nulls");
+  return cudf::detail::make_host_vector(
+    cudf::device_span<T const>{column.data<T>(), static_cast<std::size_t>(column.size())}, stream);
+}
+
+template <typename T>
+void test_numeric(T lower, T upper, cuda::stream_ref stream)
+{
+  constexpr cudf::size_type rows = 257;
+  auto mr                        = cudf::get_current_device_resource_ref();
+  auto draw                      = [&](cudf::size_type count, uint32_t seed) {
+    auto column =
+      cudf::datagen::generate_random_numeric_column<T>(lower, upper, count, stream, mr, seed);
+    CUDF_EXPECTS(column->size() == count, "Generated row count changed");
+    return host_values<T>(column->view(), stream);
+  };
+  auto default_draw = [&] {
+    return host_values<T>(
+      cudf::datagen::generate_random_numeric_column<T>(lower, upper, rows, stream, mr)->view(),
+      stream);
+  };
+  auto const defaults = default_draw();
+  CUDF_EXPECTS(defaults == draw(rows, 1), "Default seed differs from explicit seed 1");
+
+  // Replay the legacy per-index engine on the CPU, without the new seed API.
+  using distribution = std::conditional_t<std::is_integral_v<T>,
+                                          thrust::uniform_int_distribution<T>,
+                                          thrust::uniform_real_distribution<T>>;
+  for (cudf::size_type i = 0; i < rows; ++i) {
+    thrust::default_random_engine engine;
+    engine.discard(i);
+    auto const expected = distribution(lower, upper)(engine);
+    if constexpr (std::is_integral_v<T>) {
+      CUDF_EXPECTS(defaults[i] == expected, "Legacy integer sequence changed");
+    } else {
+      // Allow host/device floating-point rounding differences.
+      CUDF_EXPECTS(std::abs(defaults[i] - expected) <=
+                     4 * std::numeric_limits<T>::epsilon() * std::max(T{1}, std::abs(expected)),
+                   "Legacy floating-point sequence changed");
+    }
+  }
+
+  auto const seeded    = draw(rows, 42);
+  auto const alternate = draw(rows, 43);
+  CUDF_EXPECTS(seeded != defaults && seeded != alternate, "Seed does not change output");
+  CUDF_EXPECTS(seeded == draw(rows, 42), "Seeded output depends on call order");
+  CUDF_EXPECTS(defaults == default_draw(), "Default output depends on call order");
+  auto const prefix = draw(31, 42);
+  CUDF_EXPECTS(std::equal(prefix.begin(), prefix.end(), seeded.begin()), "Seeded prefix changed");
+  for (auto const* values : {&defaults, &seeded, &alternate, &prefix}) {
+    CUDF_EXPECTS(
+      std::all_of(
+        values->begin(), values->end(), [=](T value) { return lower <= value && value <= upper; }),
+      "Generated value outside bounds");
+  }
+}
+
+void test_supplier_keys(cuda::stream_ref stream)
+{
+  bool valid = true;
+  for (double scale_factor : {0.01, 0.1, 1.0}) {
+    auto const s = static_cast<cudf::size_type>(scale_factor * 10'000);
+    std::vector<cudf::size_type> keys;
+    for (auto key : {1, s - 1, s, s + 1, 2 * s, 20 * s}) {
+      keys.insert(keys.end(), 4, key);
+    }
+    cudf::test::fixed_width_column_wrapper<cudf::size_type> partkey(keys.begin(), keys.end());
+    CUDF_CUDA_TRY(cudaDeviceSynchronize());
+    auto const rows = static_cast<cudf::size_type>(keys.size());
+    std::vector<cudf::size_type> expected(rows);
+    for (cudf::size_type row = 0; row < rows; ++row) {
+      expected[row] = (keys[row] + (row % 4) * (s / 4 + (keys[row] - 1) / s)) % s + 1;
+    }
+    for (bool partsupp : {false, true}) {
+      auto result       = partsupp
+                            ? cudf::datagen::calculate_ps_suppkey(partkey, scale_factor, rows, stream)
+                            : cudf::datagen::calculate_l_suppkey(partkey, scale_factor, rows, stream);
+      auto const actual = host_values<cudf::size_type>(result->view(), stream);
+      CUDF_EXPECTS(actual.size() == expected.size(), "Supplier key row count changed");
+      cudf::size_type mismatches = 0, out_of_range = 0;
+      for (cudf::size_type row = 0; row < rows; ++row) {
+        mismatches += actual[row] != expected[row];
+        out_of_range += actual[row] < 1 || actual[row] > s;
+      }
+      std::cout << (partsupp ? "ps_suppkey" : "l_suppkey") << " sf=" << scale_factor
+                << " suppliers=" << s << " rows=" << rows << " mismatches=" << mismatches
+                << " out_of_range=" << out_of_range << " first_actual=" << actual.front()
+                << " first_expected=" << expected.front() << " last_actual=" << actual.back()
+                << " last_expected=" << expected.back() << '\n';
+      valid = valid && mismatches == 0 && out_of_range == 0;
+    }
+  }
+  CUDF_EXPECTS(valid, "Supplier key formula/range mismatch");
+}
+
+void test_order_date_coverage(cuda::stream_ref stream)
+{
+  auto [orders, lineitem, part] = cudf::datagen::generate_orders_lineitem_part(0.01, stream);
+  auto const dates              = host_values<cudf::timestamp_D>(orders->view().column(4), stream);
+  std::map<int, std::set<unsigned>> months_by_year;
+  for (auto const value : dates) {
+    auto const date = std::chrono::sys_days{std::chrono::days{value.time_since_epoch().count()}};
+    auto const calendar = std::chrono::year_month_day{date};
+    CUDF_EXPECTS(calendar.ok(), "Invalid generated order date");
+    months_by_year[int{calendar.year()}].insert(unsigned{calendar.month()});
+  }
+  std::size_t combinations = 0;
+  for (auto const& [year, months] : months_by_year) {
+    std::cout << "order_dates year=" << year << " months=" << months.size() << '\n';
+    combinations += months.size();
+  }
+  CUDF_EXPECTS(months_by_year.size() == 7 && combinations == 7 * 12,
+               "Order year/month components share a correlated RNG stream");
+}
+
+void test_lineitem_q6(cuda::stream_ref stream)
+{
+  auto [orders, lineitem, part] = cudf::datagen::generate_orders_lineitem_part(0.01, stream);
+  CUDF_EXPECTS(lineitem->num_columns() == 16 && part->num_columns() == 9,
+               "Unexpected lineitem/part schema");
+  auto const part_keys = host_values<cudf::size_type>(part->view().column(0), stream);
+  auto const retail    = host_values<double>(part->view().column(7), stream);
+  std::map<cudf::size_type, double> retail_by_key;
+  for (cudf::size_type i = 0; i < part->num_rows(); ++i) {
+    CUDF_EXPECTS(retail_by_key.emplace(part_keys[i], retail[i]).second, "Duplicate part key");
+  }
+  auto const item_keys = host_values<cudf::size_type>(lineitem->view().column(1), stream);
+  auto const quantity  = host_values<int8_t>(lineitem->view().column(4), stream);
+  auto const price     = host_values<double>(lineitem->view().column(5), stream);
+  // Resolve by key on the CPU, independently of GPU join output order.
+  for (cudf::size_type i = 0; i < lineitem->num_rows(); ++i) {
+    auto const part_row = retail_by_key.find(item_keys[i]);
+    CUDF_EXPECTS(part_row != retail_by_key.end(), "Missing lineitem part key");
+    auto const expected = static_cast<double>(quantity[i]) * part_row->second;
+    CUDF_EXPECTS(std::abs(price[i] - expected) <= 1e-12 * std::max(1.0, std::abs(expected)),
+                 "l_extendedprice is not aligned with its lineitem row");
+  }
+  // Check generated-data selectivity without depending on the query harness or its CPU reference.
+  auto const discount     = host_values<double>(lineitem->view().column(6), stream);
+  auto const shipdate     = host_values<cudf::timestamp_D>(lineitem->view().column(10), stream);
+  cudf::size_type matched = 0;
+  double revenue          = 0;
+  for (cudf::size_type i = 0; i < lineitem->num_rows(); ++i) {
+    auto const date = shipdate[i].time_since_epoch().count();
+    auto const d    = static_cast<float>(discount[i]);
+    auto const q    = static_cast<float>(quantity[i]);
+    // Q6 uses float32 predicates and the half-open date range [1994-01-01, 1995-01-01).
+    if (8766 <= date && date < 9131 && 0.05f <= d && d <= 0.07f && q < 24.0f) {
+      ++matched;
+      revenue += price[i] * discount[i];
+    }
+  }
+  std::cout << "lineitem_q6 sf=0.01 rows=" << lineitem->num_rows() << " matched=" << matched
+            << " revenue=" << std::setprecision(17) << revenue << '\n';
+  CUDF_EXPECTS(matched > 0, "Q6 has no survivors: quantity/discount correlation regressed");
+  CUDF_EXPECTS(std::isfinite(revenue) && revenue > 0, "Q6 revenue must be positive and finite");
+}
+}  // namespace
+
+int main()
+{
+  char const* current_test = "initialization";
+  try {
+    cuda::stream_ref const stream = cudf::get_default_stream();
+    auto run                      = [&](char const* name, auto&& test) {
+      current_test = name;
+      test();
+      stream.sync();
+      std::cout << "[PASS] " << name << '\n';
+    };
+    run("int8", [&] { test_numeric<int8_t>(-10, 20, stream); });
+    run("int16", [&] { test_numeric<int16_t>(-1000, 2000, stream); });
+    run("size_type", [&] { test_numeric<cudf::size_type>(-100000, 200000, stream); });
+    run("double", [&] { test_numeric<double>(0.0, 0.1, stream); });
+    run("order_date_coverage", [&] { test_order_date_coverage(stream); });
+    run("lineitem_q6", [&] { test_lineitem_q6(stream); });
+    run("supplier_keys", [&] { test_supplier_keys(stream); });
+    return 0;
+  } catch (std::exception const& error) {
+    std::cerr << "[FAIL] " << current_test << ": " << error.what() << '\n';
+    return 1;
+  }
+}
