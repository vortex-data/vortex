@@ -0,0 +1,90 @@
+# =============================================================================
+# cmake-format: off
+# SPDX-FileCopyrightText: Copyright (c) 2026, NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+# cmake-format: on
+# =============================================================================
+
+option(CUDF_NDSH_WITH_VORTEX "Build the experimental Vortex integration for NDS-H Q1/Q6" OFF)
+if(NOT CUDF_NDSH_WITH_VORTEX)
+  return()
+endif()
+
+if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
+  message(FATAL_ERROR "CUDF_NDSH_WITH_VORTEX requires Linux and a CUDA toolkit")
+endif()
+
+include(FetchContent)
+
+# Scope Vortex's options to this dependency; do not change the parent's cache or warning policy.
+block()
+# Local-only until the pin includes the prerequisites; the header check cannot verify runtime fixes.
+string(
+  CONCAT
+    vortex_local_required
+    "CUDF_NDSH_WITH_VORTEX=ON requires a local Vortex checkout with prerequisite fixes. "
+    "Use -DFETCHCONTENT_SOURCE_DIR_VORTEX=/path/to/vortex. "
+    "Fetching is disabled pending a fixed published immutable revision."
+)
+if(NOT DEFINED FETCHCONTENT_SOURCE_DIR_VORTEX OR FETCHCONTENT_SOURCE_DIR_VORTEX STREQUAL "")
+  message(FATAL_ERROR "${vortex_local_required}")
+endif()
+if(NOT IS_DIRECTORY "${FETCHCONTENT_SOURCE_DIR_VORTEX}")
+  message(
+    FATAL_ERROR
+      "FETCHCONTENT_SOURCE_DIR_VORTEX is not an existing directory: ${FETCHCONTENT_SOURCE_DIR_VORTEX}\n"
+      "${vortex_local_required}"
+  )
+endif()
+set(vortex_cuda_header "${FETCHCONTENT_SOURCE_DIR_VORTEX}/vortex-cuda/ffi/cinclude/vortex_cuda.h")
+set(vortex_cuda_decode_flag "")
+if(EXISTS "${vortex_cuda_header}" AND NOT IS_DIRECTORY "${vortex_cuda_header}")
+  file(STRINGS "${vortex_cuda_header}" vortex_cuda_decode_flag
+       REGEX "^[ \t]*#[ \t]*define[ \t]+VX_CUDA_SCAN_FLAG_DECODE_DICTIONARIES[ \t]+"
+  )
+endif()
+if(NOT vortex_cuda_decode_flag)
+  message(FATAL_ERROR "${vortex_cuda_header} must export VX_CUDA_SCAN_FLAG_DECODE_DICTIONARIES.\n"
+                      "${vortex_local_required}"
+  )
+endif()
+
+set(VORTEX_ENABLE_CUDA ON)
+set(VORTEX_BUILD_TESTS OFF)
+set(VORTEX_BUILD_EXAMPLES OFF)
+set(VORTEX_WARNINGS_AS_ERRORS OFF)
+
+# Cargo requires a complete checkout. Replace this base pin when the fixes are published.
+FetchContent_Declare(
+  Vortex
+  GIT_REPOSITORY https://github.com/vortex-data/vortex.git
+  GIT_TAG bffdca1109e99e6957ea2fc18f4a7809c88e0a0c
+  GIT_SHALLOW FALSE
+  SOURCE_SUBDIR lang/cpp EXCLUDE_FROM_ALL SYSTEM
+)
+FetchContent_MakeAvailable(Vortex)
+endblock()
+
+add_library(NDSH_VORTEX_IO STATIC EXCLUDE_FROM_ALL "${CMAKE_CURRENT_LIST_DIR}/vortex_io.cpp")
+target_compile_features(NDSH_VORTEX_IO PUBLIC cxx_std_20)
+target_include_directories(NDSH_VORTEX_IO PUBLIC "${CMAKE_CURRENT_LIST_DIR}")
+target_link_libraries(
+  NDSH_VORTEX_IO
+  PUBLIC cudf::cudf
+  PRIVATE Vortex::cpp_static nanoarrow::nanoarrow CUDA::cudart
+)
+
+foreach(benchmark IN ITEMS NDSH_Q01_NVBENCH NDSH_Q06_NVBENCH)
+  target_link_libraries(${benchmark} PRIVATE NDSH_VORTEX_IO)
+  target_compile_definitions(${benchmark} PRIVATE CUDF_NDSH_WITH_VORTEX=1)
+endforeach()
+
+# Explicit target: exercise real cuDF, C++ wrapper, and CUDA FFI symbols before building NDS-H.
+add_executable(
+  NDSH_VORTEX_BUILD_SMOKE EXCLUDE_FROM_ALL "${CMAKE_CURRENT_LIST_DIR}/vortex_build_smoke.cpp"
+)
+target_compile_features(NDSH_VORTEX_BUILD_SMOKE PRIVATE cxx_std_20)
+target_link_libraries(NDSH_VORTEX_BUILD_SMOKE PRIVATE cudf::cudf Vortex::cpp_static)
+
+add_executable(NDSH_VORTEX_IO_TEST EXCLUDE_FROM_ALL "${CMAKE_CURRENT_LIST_DIR}/vortex_io_test.cpp")
+target_link_libraries(NDSH_VORTEX_IO_TEST PRIVATE NDSH_VORTEX_IO nanoarrow::nanoarrow CUDA::cudart)
