+{
+  if (!vortex) { return read_parquet(cudf::io::source_info{path}, q6_columns); }
+  auto result = io.read_vortex(path, 1 << 20, q6_columns);
+  std::vector<std::string> names;
+  for (auto const& field : result.metadata.schema_info) {
+    names.push_back(field.name);
+  }
+  return std::make_unique<table_with_names>(std::move(result.tbl), std::move(names));
+}
+
+void check_projection(cudf::table_view expected, table_with_names const& actual)
+{
+  CUDF_EXPECTS(
+    actual.column_names() == q6_columns && actual.table().num_rows() == expected.num_rows(),
+    "Q6 projected schema/row count mismatch");
+  for (cudf::size_type i = 0; i < expected.num_columns(); ++i) {
+    auto const lhs = expected.column(i);
+    auto const rhs = actual.table().column(i);
+    CUDF_EXPECTS(lhs.type() == rhs.type(), "Q6 projected type mismatch");
+    if (lhs.is_empty()) { continue; }
+    auto equal = cudf::binary_operation(
+      lhs, rhs, cudf::binary_operator::NULL_EQUALS, cudf::data_type{cudf::type_id::BOOL8});
+    auto all = cudf::reduce(equal->view(),
+                            *cudf::make_all_aggregation<cudf::reduce_aggregation>(),
+                            cudf::data_type{cudf::type_id::BOOL8});
+    CUDF_EXPECTS(all->is_valid() && static_cast<cudf::numeric_scalar<bool> const&>(*all).value(),
+                 "Q6 projected values mismatch");
+  }
+}
+
+std::optional<double> revenue_value(table_with_names const& result)
+{
+  auto value = cudf::get_element(result.column("revenue"), 0);
+  if (!value->is_valid()) { return std::nullopt; }
+  return static_cast<cudf::numeric_scalar<double> const&>(*value).value();
+}
+
+void check_q6_boundaries()
+{
+  cudf::test::fixed_width_column_wrapper<double> price{
+    {100, 100, 100, 100, 100, 100, 100, 100, 100}};
+  cudf::test::fixed_width_column_wrapper<double> discount{
+    {0.06, 0.05, 0.07, 0.06, 0.049, 0.071, 0.06, 0.06, 0.06},
+    {true, true, true, true, true, true, true, true, false}};
+  // Epoch days: 1993-12-31, 1994-01-01, 1994-12-31, 1995-01-01.
+  cudf::test::fixed_width_column_wrapper<cudf::timestamp_D, int32_t> shipdate{
+    {8765, 8766, 9130, 9131, 8766, 8766, 8766, 8766, 8766}};
+  cudf::test::fixed_width_column_wrapper<double> quantity{{23, 23, 23, 23, 23, 23, 24, 23, 23}};
+  CUDF_CUDA_TRY(cudaDeviceSynchronize());
+  auto result = execute_q6(
+    [&](auto const& columns, auto const&) {
+      return std::make_unique<table_with_names>(
+        std::make_unique<cudf::table>(cudf::table_view{{price, discount, shipdate, quantity}}),
+        columns);
+    },
+    true);
+  auto value = revenue_value(*result);
+  CUDF_EXPECTS(value && std::abs(*value - 18.0) < 1e-8, "Q6 boundary/null regression");
+}
+
+struct q6_files {
+  temp_directory directory{"ndsh_q6_local"};
+  std::string parquet{directory.path() + "lineitem.parquet"};
+  std::string vortex{directory.path() + "lineitem.vortex"};
+  cudf::size_type rows;
+  cudf::size_type matched;
+  double revenue;
+
+  q6_files(double scale_factor, ndsh::vortex_io const& io)
+  {
+    auto generated = generate_lineitem(scale_factor);
+    rows           = generated->table().num_rows();
+    generated->to_parquet(parquet);
+    io.write_vortex(vortex, generated->table(), generated->column_names());
+    auto const reference =
+      ndsh::q6_cpu_reference(generated->select(q6_columns), cudf::get_default_stream());
+    matched = reference.matched;
+    revenue = reference.revenue;
+    CUDF_EXPECTS(matched > 0 && std::isfinite(revenue) && revenue > 0,
+                 "Q6 fixture has no positive revenue; check generator RNG streams");
+    for (bool use_vortex : {false, true}) {
+      auto input = read_q6_file(path(use_vortex), use_vortex, io);
+      check_projection(generated->select(q6_columns), *input);
+      auto result = execute_q6([&](auto const&, auto const&) { return std::move(input); }, true);
+      auto value  = revenue_value(*result);
+      CUDF_EXPECTS(value && std::isfinite(*value) &&
+                     std::abs(*value - revenue) <= 1e-10 * std::max(1.0, std::abs(revenue)),
+                   "Q6 GPU revenue differs from CPU reference");
+    }
+    CUDF_CUDA_TRY(cudaDeviceSynchronize());
+  }
+
+  std::string const& path(bool use_vortex) const { return use_vortex ? vortex : parquet; }
+};
+
+q6_files const& q6_fixture(double scale_factor)
+{
+  // Cache only files/host results, so all format/workload states use identical rows.
+  static std::map<double, std::unique_ptr<q6_files>> fixtures;
+  auto& files = fixtures[scale_factor];
+  if (!files) {
+    check_q6_boundaries();
+    ndsh::vortex_io io{cuda::stream_ref{cudf::get_default_stream()}.get()};
+    files = std::make_unique<q6_files>(scale_factor, io);
+  }
+  return *files;
+}
+
+void ndsh_q6_local(nvbench::state& state)
+{
+  auto const format   = state.get_string("format");
+  auto const workload = state.get_string("workload");
+  CUDF_EXPECTS(format == "parquet" || format == "vortex", "Unknown Q6 format");
+  CUDF_EXPECTS(workload == "read" || workload == "q6", "Unknown Q6 workload");
+  auto const use_vortex         = format == "vortex";
+  auto const& files             = q6_fixture(state.get_float64("scale_factor"));
+  cuda::stream_ref const stream = cudf::get_default_stream();
+  state.set_cuda_stream(nvbench::make_cuda_stream_view(stream.get()));
+  auto const memory = cudf::memory_stats_logger();
+  ndsh::vortex_io io{stream.get()};
+  auto read = [&] { return read_q6_file(files.path(use_vortex), use_vortex, io); };
+  // Warm the selected reader and OS page cache; this is not a cold-storage benchmark.
+  {
+    auto warmup = read();
+  }
+  CUDF_CUDA_TRY(cudaDeviceSynchronize());
+  state.add_element_count(files.rows, "Rows");
+  state.exec(nvbench::exec_tag::sync, [&](nvbench::launch&) {
+    {
+      auto result = workload == "read"
+                      ? read()
+                      : execute_q6([&](auto const&, auto const&) { return read(); }, true);
+      CUDF_CUDA_TRY(cudaStreamSynchronize(stream.get()));
+    }
+    // Include cleanup queued on Vortex's independent producer streams, for both formats.
+    CUDF_CUDA_TRY(cudaDeviceSynchronize());
+  });
+  state.add_buffer_size(
+    std::filesystem::file_size(files.path(use_vortex)), "file_size", "File size");
+  state.add_buffer_size(memory.peak_memory_usage(), "rmm_peak", "RMM peak (excludes Vortex)");
+  auto& summary = state.add_summary("ndsh/q6/revenue");
+  summary.set_string("name", "Verified revenue");
+  summary.set_float64("value", files.revenue);
+  auto& matched = state.add_summary("ndsh/q6/matched_rows");
+  matched.set_string("name", "Q6 matched rows");
+  matched.set_int64("value", files.matched);
+}
+
+}  // namespace
+
+NVBENCH_BENCH(ndsh_q6_local)
+  .set_name("ndsh_q6_local_warm")
+  .add_float64_axis("scale_factor", {0.01, 0.1, 1})
+  .add_string_axis("format", {"parquet", "vortex"})
+  .add_string_axis("workload", {"read", "q6"});
+#endif
