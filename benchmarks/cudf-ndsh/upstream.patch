+void check_arrow(int status, char const* operation, ArrowError const& error = {})
+{
+  if (status != NANOARROW_OK) {
+    throw std::runtime_error(std::string{operation} + " (" + std::to_string(status) +
+                             "): " + error.message);
+  }
+}
