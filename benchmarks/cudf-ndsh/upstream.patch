+namespace ndsh {
+
+/**
+ * Single-threaded, device-0 I/O context reusing CUDA state and pinned staging.
+ * Caller stream/resource must outlive this context and returned tables.
+ * Requires at least one flat, typed column; zero-row tables are supported.
+ */
+class vortex_io {
+ public:
+  explicit vortex_io(cudaStream_t stream,
+                     rmm::device_async_resource_ref mr = cudf::get_current_device_resource_ref());
+  ~vortex_io();
+  vortex_io(vortex_io const&)            = delete;
+  vortex_io& operator=(vortex_io const&) = delete;
+
+  /**
+   * Write a CUDA-readable local file on CPU via host Arrow chunks. Requires positive
+   * chunk_rows, non-dictionary input, and NUL-free column names. Partial string
+   * slices are compacted on device. Chunking bounds rows, not total bytes/queue memory.
+   * Finalizes before return; failed writes may leave an invalid file.
+   */
+  void write_vortex(std::string const& path,
+                    cudf::table_view table,
+                    std::vector<std::string> const& column_names,
+                    cudf::size_type chunk_rows = 1 << 20) const;
+
+  /**
+   * GPU-read a local CUDA-compatible file into an owning cuDF table. An empty column
+   * list selects all; otherwise scan literal top-level names in order. Unknown or
+   * duplicate names are errors. Includes dictionary decode, import/copies,
+   * concatenation, and consumer completion
+   * including temporary cleanup. Zero batch_rows uses layout-derived splitting.
+   * Peak memory includes owned batches plus the concatenated result.
+   */
+  [[nodiscard]] cudf::io::table_with_metadata read_vortex(
+    std::string const& path,
+    std::size_t batch_rows                  = 1 << 20,
+    std::vector<std::string> const& columns = {}) const;
+
+ private:
+  struct impl;
+  std::unique_ptr<impl> impl_;
+};
+
+}  // namespace ndsh
