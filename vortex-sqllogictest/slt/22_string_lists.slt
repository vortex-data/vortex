include ./setup.slt.no

query I
COPY (SELECT * FROM (VALUES
    (['apple', 'banana', 'cherry']),
    (['date', 'elderberry']),
    (['fig', 'grape', 'honeydew', 'kiwi']),
    (['lemon', 'mango', 'nectarine'])
) t(string_list)) TO '${WORK_DIR}/string-lists.vortex';
----
4

query ? rowsort
SELECT string_list FROM '${WORK_DIR}/string-lists.vortex';
----
[apple, banana, cherry]
[date, elderberry]
[fig, grape, honeydew, kiwi]
[lemon, mango, nectarine]
