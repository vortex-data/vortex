                                                                "p_size",
                                                                "p_container",
                                                                "p_retailprice",
                                                                "p_comment"
                                                            ]
                                                        }
                                                    }
                                                ],
                                                "extra_info": {
                                                    "Expressions": ""
                                                }
                                            },
                                            {
                                                "name": "PROJECTION",
                                                "children": [
                                                    {
                                                        "name": "FILTER",
                                                        "children": [
