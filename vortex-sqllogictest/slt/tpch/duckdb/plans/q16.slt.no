                                            "Conditions": "(ps_suppkey = #[27.0])"
                                        }
                                    }
                                ],
                                "extra_info": {
                                    "Expressions": [
                                        "(p_partkey = ps_partkey)",
                                        "(p_brand != CAST('Brand#45' AS VARCHAR))",
                                        "(p_type !~~ 'MEDIUM POLISHED%')",
                                        "(p_size IN (CAST(49 AS INTEGER), CAST(14 AS INTEGER), CAST(23 AS INTEGER), CAST(45 AS INTEGER), CAST(19 AS INTEGER), CAST(3 AS INTEGER), CAST(36 AS INTEGER), CAST(9 AS INTEGER)))",
                                        "(NOT SUBQUERY)"
                                    ]
                                }
                            }
                        ],
                        "extra_info": {
                            "Groups": [
                                "p_brand",
                                "p_type",
                                "p_size"
                            ],
                            "Expressions": "count(DISTINCT ps_suppkey)"
                        }
                    }
                ],
                "extra_info": {
                    "Expressions": [
                        "p_brand",
                        "p_type",
                        "p_size",
                        "supplier_cnt"
                    ]
                }
            }
        ],
        "extra_info": {
