                                                                        }
                                                                    }
                                                                ],
                                                                "extra_info": {
                                                                    "Expressions": [
                                                                        "s_suppkey",
                                                                        "s_name",
                                                                        "s_address",
                                                                        "s_nationkey",
                                                                        "s_phone",
                                                                        "s_acctbal",
                                                                        "s_comment"
                                                                    ]
