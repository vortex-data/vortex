        "children": [
            {
                "name": "AGGREGATE",
                "children": [
                    {
                        "name": "PROJECTION",
                        "children": [
                            {
                                "name": "READ_VORTEX",
                                "children": [],
                                "extra_info": {
                                    "Filters": [
                                        "(1994-01-01 <= $.l_shipdate < 1995-01-01)",
                                        "(decimal128(5, precision=15, scale=2) <= $.l_discount <= decimal128(7, precision=15, scale=2))",
                                        "($.l_quantity < decimal128(2400, precision=15, scale=2))"
                                    ],
                                    "Function": "Vortex Scan",
                                    "Estimated Cardinality": "120114"
                                }
                            }
                        ],
                        "extra_info": {
                            "Expressions": [
                                "l_extendedprice",
                                "l_discount"
