                                                                        "(ws_sold_date_sk = d_date_sk)",
                                                                        "(ws_sold_time_sk = t_time_sk)",
                                                                        "(ws_ship_mode_sk = sm_ship_mode_sk)",
                                                                        "(d_year = CAST(2001 AS BIGINT))",
                                                                        "(t_time >= CAST(30838 AS BIGINT))",
                                                                        "(sm_carrier IN (CAST('DHL' AS VARCHAR), CAST('BARIAN' AS VARCHAR)))",
