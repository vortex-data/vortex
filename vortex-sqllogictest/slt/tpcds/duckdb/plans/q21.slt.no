                                        "(CASE  WHEN ((inv_before > CAST(0 AS HUGEINT))) THEN ((CAST((inv_after * CAST(1.000 AS DECIMAL(38,3))) AS DOUBLE) / CAST(inv_before AS DOUBLE))) ELSE CAST(NULL AS DOUBLE) END <= (CAST(3.000 AS DOUBLE) / CAST(2.000 AS DOUBLE)))"
