04)------Filter: CASE WHEN ws.ws_qty IS NOT NULL THEN ws.ws_qty ELSE Int64(0) END > Int64(0) OR CASE WHEN cs.cs_qty IS NOT NULL THEN cs.cs_qty ELSE Int64(0) END > Int64(0)
