02)--Projection: y.d_week_seq1, round(y.sun_sales1 / z.sun_sales2, Int32(2)) AS r1, round(y.mon_sales1 / z.mon_sales2, Int32(2)) AS r2, round(y.tue_sales1 / z.tue_sales2, Int32(2)) AS r3, round(y.wed_sales1 / z.wed_sales2, Int32(2)) AS r4, round(y.thu_sales1 / z.thu_sales2, Int32(2)) AS r5, round(y.fri_sales1 / z.fri_sales2, Int32(2)) AS r6, round(y.sat_sales1 / z.sat_sales2, Int32(2)) AS round(y.sat_sales1 / z.sat_sales2,Int64(2))
