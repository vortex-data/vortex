# Keep fixture paths under WORK_DIR so EXPLAIN output can normalize them.
# Plans ignore byte ranges because they depend on the generated fixture sizes.
system ok
cp slt/job/data/*.$FILE_FORMAT "$WORK_DIR/"

statement ok
CREATE EXTERNAL TABLE IF NOT EXISTS aka_name
STORED AS ${FILE_FORMAT}
LOCATION '${WORK_DIR}/aka_name.${FILE_FORMAT}';

statement ok
CREATE EXTERNAL TABLE IF NOT EXISTS aka_title
STORED AS ${FILE_FORMAT}
LOCATION '${WORK_DIR}/aka_title.${FILE_FORMAT}';

