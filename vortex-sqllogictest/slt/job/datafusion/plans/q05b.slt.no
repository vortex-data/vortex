17)------------------------TableScan: movie_companies projection=[movie_id, company_type_id, note], partial_filters=[movie_companies.note LIKE Utf8View("%(VHS)%"), movie_companies.note LIKE Utf8View("%(USA)%"), movie_companies.note LIKE Utf8View("%(1994)%")]
