query TT
EXPLAIN
SELECT MIN(t.title) AS movie_title
FROM keyword AS k,
     movie_info AS mi,
     movie_keyword AS mk,
     title AS t
WHERE k.keyword LIKE '%sequel%'
  AND mi.info IN ('Sweden',
                  'Norway',
                  'Germany',
                  'Denmark',
                  'Swedish',
                  'Denish',
                  'Norwegian',
                  'German')
  AND t.production_year > 2005
  AND t.id = mi.movie_id
  AND t.id = mk.movie_id
  AND mk.movie_id = mi.movie_id
  AND k.id = mk.keyword_id;
----
logical_plan
01)Projection: min(t.title) AS movie_title
02)--Aggregate: groupBy=[[]], aggr=[[min(t.title)]]
03)----Projection: t.title
04)------Inner Join: mi.movie_id = t.id, mk.movie_id = t.id
05)--------Inner Join: mk.movie_id = mi.movie_id
06)----------Projection: mk.movie_id
07)------------Inner Join: k.id = mk.keyword_id
08)--------------SubqueryAlias: k
09)----------------Projection: keyword.id
10)------------------Filter: keyword.keyword LIKE Utf8View("%sequel%")
11)--------------------TableScan: keyword projection=[id, keyword], partial_filters=[keyword.keyword LIKE Utf8View("%sequel%")]
12)--------------SubqueryAlias: mk
13)----------------TableScan: movie_keyword projection=[movie_id, keyword_id]
14)----------SubqueryAlias: mi
15)------------Projection: movie_info.movie_id
16)--------------Filter: movie_info.info IN ([Utf8View("Sweden"), Utf8View("Norway"), Utf8View("Germany"), Utf8View("Denmark"), Utf8View("Swedish"), Utf8View("Denish"), Utf8View("Norwegian"), Utf8View("German")])
17)----------------TableScan: movie_info projection=[movie_id, info], partial_filters=[movie_info.info IN ([Utf8View("Sweden"), Utf8View("Norway"), Utf8View("Germany"), Utf8View("Denmark"), Utf8View("Swedish"), Utf8View("Denish"), Utf8View("Norwegian"), Utf8View("German")])]
18)--------SubqueryAlias: t
19)----------Projection: title.id, title.title
20)------------Filter: title.production_year > Float64(2005)
21)--------------TableScan: title projection=[id, title, production_year], partial_filters=[title.production_year > Float64(2005)]
