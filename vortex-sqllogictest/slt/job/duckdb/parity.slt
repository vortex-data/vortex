# Checks that every Vortex table produced by generate_data.sh holds exactly the
# same rows as the Parquet table it was converted from. generate_data.sh runs
# this file right after the conversion, and it also runs as part of the suite.

include ../../setup.slt.no

# aka_name
query TT rowsort
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM read_parquet('slt/job/data/aka_name.parquet'))
EXCEPT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM read_vortex('slt/job/data/aka_name.vortex'));
----

query I
SELECT (SELECT COUNT(*) FROM read_parquet('slt/job/data/aka_name.parquet')) - (SELECT COUNT(*) FROM read_vortex('slt/job/data/aka_name.vortex'));
----
0

query I
SELECT COUNT(*) FROM (SELECT * FROM read_parquet('slt/job/data/aka_name.parquet') EXCEPT ALL SELECT * FROM read_vortex('slt/job/data/aka_name.vortex'));
----
0

query I
SELECT COUNT(*) FROM (SELECT * FROM read_vortex('slt/job/data/aka_name.vortex') EXCEPT ALL SELECT * FROM read_parquet('slt/job/data/aka_name.parquet'));
----
0

