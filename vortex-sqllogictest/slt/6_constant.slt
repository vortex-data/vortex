include ./setup.slt.no

query I
COPY (SELECT 42 AS constant FROM generate_series(1, 100) t(i)) TO '${WORK_DIR}/constant.vortex';
----
100

query I
SELECT constant FROM '${WORK_DIR}/constant.vortex' LIMIT 1;
----
42
