include ./setup.slt.no

query I
COPY (SELECT * FROM (VALUES
    ({'name': 'alice', 'info': {'age': 30, 'city': 'NYC'}}, 100),
    ({'name': 'bob', 'info': {'age': 25, 'city': 'LA'}}, 200),
    ({'name': 'charlie', 'info': {'age': 35, 'city': 'NYC'}}, 300),
    ({'name': 'diana', 'info': {'age': 28, 'city': 'SF'}}, 400),
    ({'name': 'eve', 'info': {'age': 30, 'city': 'LA'}}, 500)
) AS t(person, value)) TO '${WORK_DIR}/nested_structs.vortex';
----
5

query I rowsort
SELECT value FROM '${WORK_DIR}/nested_structs.vortex' WHERE person.name = 'bob';
----
200

query I rowsort
SELECT value FROM '${WORK_DIR}/nested_structs.vortex' WHERE person.info.age = 30 ORDER BY value;
----
100
500

query I rowsort
SELECT value FROM '${WORK_DIR}/nested_structs.vortex' WHERE person.info.city = 'NYC' ORDER BY value;
----
100
300

query I rowsort
SELECT value FROM '${WORK_DIR}/nested_structs.vortex' WHERE person.info.age > 28 ORDER BY value;
----
100
300
500

query I rowsort
SELECT value FROM '${WORK_DIR}/nested_structs.vortex' WHERE person.info.age >= 30 AND person.info.city = 'NYC';
----
100
300

query I rowsort
SELECT SUM(value) FROM '${WORK_DIR}/nested_structs.vortex' WHERE person.info.city IN ('NYC', 'SF');
----
800

query I
COPY (SELECT * FROM (VALUES
    ({'level1': {'level2': {'level3': 1}}}, 'a'),
    ({'level1': {'level2': {'level3': 2}}}, 'b'),
    ({'level1': {'level2': {'level3': 3}}}, 'c'),
    ({'level1': {'level2': {'level3': 1}}}, 'd')
) AS t(deep, label)) TO '${WORK_DIR}/deep_nested.vortex';
----
4

query T rowsort
SELECT label FROM '${WORK_DIR}/deep_nested.vortex' WHERE deep.level1.level2.level3 = 1 ORDER BY label;
----
a
d

query T rowsort
SELECT label FROM '${WORK_DIR}/deep_nested.vortex' WHERE deep.level1.level2.level3 >= 2 ORDER BY label;
----
b
c
