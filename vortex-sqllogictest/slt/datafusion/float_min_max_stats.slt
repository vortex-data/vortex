include ../setup.slt.no

query I
COPY (SELECT CAST(column1 AS DOUBLE) AS x FROM (VALUES (1), (2), (3))) TO '${WORK_DIR}/float_min_max_stats.vortex';
----
3

query TT
EXPLAIN SELECT max(x) FROM '${WORK_DIR}/float_min_max_stats.vortex';
----
logical_plan
01)Aggregate: groupBy=[[]], aggr=[[max(${WORK_DIR}/float_min_max_stats.vortex.x)]]
02)--TableScan: ${WORK_DIR}/float_min_max_stats.vortex projection=[x]
physical_plan
01)ProjectionExec: expr=[3 as max(${WORK_DIR}/float_min_max_stats.vortex.x)]
02)--PlaceholderRowExec
