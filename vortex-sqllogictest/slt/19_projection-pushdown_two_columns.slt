include ./setup.slt.no

# Check projection pushdowns with different sets of pre- and
# post-filter column set

query I
COPY (SELECT 'ololo' AS id, '' AS id2) TO '${WORK_DIR}/projection-pushdown-id2.vortex';
----
1

query I
SELECT 0 FROM '${WORK_DIR}/projection-pushdown-id2.vortex';
----
0

onlyif duckdb
query TTI
SELECT * FROM (
    SELECT id, id2, 0 AS const FROM '${WORK_DIR}/projection-pushdown-id2.vortex'
    UNION ALL SELECT '' AS id, '' AS id2, 0 AS const
)
----
ololo (empty) 0
(empty) (empty) 0

onlyif datafusion
query TTI
SELECT * FROM (
    SELECT id, id2, 0 AS const FROM '${WORK_DIR}/projection-pushdown-id2.vortex'
    UNION ALL SELECT '' AS id, '' AS id2, 0 AS const
)
ORDER BY id;
----
(empty) (empty) 0
ololo (empty) 0

query I
SELECT count(*) FROM (
    SELECT id, id2, 0 AS const FROM '${WORK_DIR}/projection-pushdown-id2.vortex'
    UNION ALL SELECT '' AS id, '' AS id2, 0 AS const
)
----
2

query TI
SELECT id, count(*) FROM (
    SELECT id, id2, 0 AS const FROM '${WORK_DIR}/projection-pushdown-id2.vortex'
    UNION ALL SELECT 'a', '', 0 AS const
)
GROUP BY id
ORDER BY id;
----
a 1
ololo 1

query T
SELECT id FROM (
    SELECT id, id2, 0 AS const FROM '${WORK_DIR}/projection-pushdown-id2.vortex'
    UNION ALL SELECT 'a', '', 0 AS const
)
ORDER BY id
----
a
ololo

query T
SELECT id FROM (
    SELECT id, id2, 0 AS const FROM '${WORK_DIR}/projection-pushdown-id2.vortex'
        WHERE id2 != ''
    UNION ALL SELECT 'a', '', 0 AS const
)
----
a
