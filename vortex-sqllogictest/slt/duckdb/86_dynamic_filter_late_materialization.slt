include ../setup.slt.no

# Synthetic multi-file Vortex tables exercising Top-N late materialization (file_row_number +
# file_index) and hash-join dynamic table filters without external data downloads.

query I
COPY (
    SELECT
        i::BIGINT AS id,
        (i * 7919) % 10000 AS sort_key,
        {'a': (i % 10)::INTEGER, 'b': 'tag_' || (i % 5)::VARCHAR} AS meta,
        'payload_1_' || lpad(i::VARCHAR, 12, '0') AS p1,
        'payload_2_' || lpad(i::VARCHAR, 12, '0') AS p2,
        'payload_3_' || lpad(i::VARCHAR, 12, '0') AS p3,
        'payload_4_' || lpad(i::VARCHAR, 12, '0') AS p4
    FROM range(10000) t(i)
) TO '${WORK_DIR}/fact_a.vortex';
----
10000

query I
COPY (
    SELECT
        (10000 + i)::BIGINT AS id,
        ((10000 + i) * 7919) % 10000 AS sort_key,
        {'a': (i % 10)::INTEGER, 'b': 'tag_' || (i % 5)::VARCHAR} AS meta,
        'payload_1_' || lpad((10000 + i)::VARCHAR, 12, '0') AS p1,
        'payload_2_' || lpad((10000 + i)::VARCHAR, 12, '0') AS p2,
        'payload_3_' || lpad((10000 + i)::VARCHAR, 12, '0') AS p3,
        'payload_4_' || lpad((10000 + i)::VARCHAR, 12, '0') AS p4
    FROM range(10000) t(i)
) TO '${WORK_DIR}/fact_b.vortex';
----
10000

query I
COPY (
    SELECT * FROM (VALUES
        (100::BIGINT, 1::BIGINT, 'x'),
        (5000::BIGINT, 2::BIGINT, 'y'),
        (7500::BIGINT, 3::BIGINT, 'w'),
        (15000::BIGINT, 4::BIGINT, 'z'),
        (NULL::BIGINT, 5::BIGINT, 'n')
    ) AS d(id, weight, lbl)
) TO '${WORK_DIR}/dim.vortex';
----
5

# Top-N over wide rows triggers late materialization with a file_row_number virtual column filter.
query TT
EXPLAIN (FORMAT json) SELECT id, sort_key, p1, p2, p3, p4
FROM '${WORK_DIR}/fact_a.vortex'
ORDER BY sort_key ASC
LIMIT 4;
----
<REGEX>:file_row_number

query IITTTT
SELECT id, sort_key, p1, p2, p3, p4
FROM '${WORK_DIR}/fact_a.vortex'
ORDER BY sort_key ASC
LIMIT 4;
----
0 0 payload_1_000000000000 payload_2_000000000000 payload_3_000000000000 payload_4_000000000000
7679 1 payload_1_000000007679 payload_2_000000007679 payload_3_000000007679 payload_4_000000007679
5358 2 payload_1_000000005358 payload_2_000000005358 payload_3_000000005358 payload_4_000000005358
3037 3 payload_1_000000003037 payload_2_000000003037 payload_3_000000003037 payload_4_000000003037

# Descending Top-N late materialization.
query TT
EXPLAIN (FORMAT json) SELECT id, sort_key, p1, p2, p3, p4
FROM '${WORK_DIR}/fact_a.vortex'
ORDER BY sort_key DESC
LIMIT 3;
----
<REGEX>:file_row_number

query IITTTT
SELECT id, sort_key, p1, p2, p3, p4
FROM '${WORK_DIR}/fact_a.vortex'
ORDER BY sort_key DESC
LIMIT 3;
----
2321 9999 payload_1_000000002321 payload_2_000000002321 payload_3_000000002321 payload_4_000000002321
4642 9998 payload_1_000000004642 payload_2_000000004642 payload_3_000000004642 payload_4_000000004642
6963 9997 payload_1_000000006963 payload_2_000000006963 payload_3_000000006963 payload_4_000000006963

# Multi-file Top-N late materialization uses both file_index and file_row_number.
query TT
EXPLAIN (FORMAT json) SELECT id, sort_key, p1, p2, p3, p4
FROM '${WORK_DIR}/fact_*.vortex'
ORDER BY sort_key ASC, id ASC
LIMIT 4;
----
<REGEX>:(?s)(file_index.*file_row_number|file_row_number.*file_index)

query IITTTT
SELECT id, sort_key, p1, p2, p3, p4
FROM '${WORK_DIR}/fact_*.vortex'
ORDER BY sort_key ASC, id ASC
LIMIT 4;
----
0 0 payload_1_000000000000 payload_2_000000000000 payload_3_000000000000 payload_4_000000000000
10000 0 payload_1_000000010000 payload_2_000000010000 payload_3_000000010000 payload_4_000000010000
7679 1 payload_1_000000007679 payload_2_000000007679 payload_3_000000007679 payload_4_000000007679
17679 1 payload_1_000000017679 payload_2_000000017679 payload_3_000000017679 payload_4_000000017679

# Multi-file descending Top-N late materialization (exercises >= dynamic filter + virtual columns).
query IITTTT
SELECT id, sort_key, p1, p2, p3, p4
FROM '${WORK_DIR}/fact_*.vortex'
ORDER BY sort_key DESC, id DESC
LIMIT 4;
----
12321 9999 payload_1_000000012321 payload_2_000000012321 payload_3_000000012321 payload_4_000000012321
2321 9999 payload_1_000000002321 payload_2_000000002321 payload_3_000000002321 payload_4_000000002321
14642 9998 payload_1_000000014642 payload_2_000000014642 payload_3_000000014642 payload_4_000000014642
4642 9998 payload_1_000000004642 payload_2_000000004642 payload_3_000000004642 payload_4_000000004642

# Runtime-filtered build side pushes an Optional(Dynamic(...)) join filter into the probe Vortex scan.
query TT
EXPLAIN (FORMAT json) SELECT f.id, d.weight, d.lbl
FROM '${WORK_DIR}/fact_a.vortex' f
JOIN (SELECT id, weight, lbl FROM '${WORK_DIR}/dim.vortex' WHERE (weight * 7) % 2 = 0 OR weight = 1) d
ON f.id = d.id
ORDER BY f.id;
----
<REGEX>:(?s)READ_VORTEX.*\$\.id

query IIT
SELECT f.id, d.weight, d.lbl
FROM '${WORK_DIR}/fact_a.vortex' f
JOIN (SELECT id, weight, lbl FROM '${WORK_DIR}/dim.vortex' WHERE (weight * 7) % 2 = 0 OR weight = 1) d
ON f.id = d.id
ORDER BY f.id;
----
100 1 x
5000 2 y

# Empty build side produces zero rows (exercises uninitialized dynamic filter).
query IIT
SELECT f.id, d.weight, d.lbl
FROM '${WORK_DIR}/fact_*.vortex' f
JOIN (SELECT id, weight, lbl FROM '${WORK_DIR}/dim.vortex' WHERE weight > 100) d
ON f.id = d.id
ORDER BY f.id;
----

# NULL build-side keys do not match.
query I
SELECT count(*)
FROM '${WORK_DIR}/fact_*.vortex' f
JOIN (SELECT id FROM '${WORK_DIR}/dim.vortex' WHERE id IS NULL) d
ON f.id = d.id;
----
0

# Multi-file hash join combined with struct field and IN filters.
query IIT
SELECT f.id, f.meta.a, d.lbl
FROM '${WORK_DIR}/fact_*.vortex' f
JOIN (SELECT id, lbl FROM '${WORK_DIR}/dim.vortex' WHERE len(lbl) = 1) d ON f.id = d.id
WHERE f.meta.a IN (0, 1) AND f.meta.b = 'tag_0'
ORDER BY f.id;
----
100 0 x
5000 0 y
7500 0 w
15000 0 z
