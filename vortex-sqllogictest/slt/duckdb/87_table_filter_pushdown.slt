include ../setup.slt.no

# Whole-system SLT coverage for DuckDB filter pushdown: virtual column filters (file_row_number,
# file_index), IN lists, conjunctions (AND/OR), IS [NOT] NULL, struct extract filters, and
# NaN-aware float filtering.

query I
COPY (
    SELECT * FROM (VALUES
        (1, 10,   1.5::DOUBLE,    {'x': 100, 'y': 'a', 'inner': {'k': 1}}),
        (2, NULL, 'nan'::DOUBLE,  {'x': 200, 'y': 'b', 'inner': {'k': 2}}),
        (3, 30,   -2.5::DOUBLE,   {'x': 300, 'y': 'c', 'inner': {'k': 3}}),
        (4, 40,   'inf'::DOUBLE,  {'x': 400, 'y': 'd', 'inner': {'k': 4}}),
        (5, NULL, '-inf'::DOUBLE, {'x': NULL, 'y': 'e', 'inner': {'k': 5}}),
        (6, 60,   0.0::DOUBLE,    {'x': 600, 'y': 'f', 'inner': {'k': 6}}),
        (7, 70,   3.5::DOUBLE,    {'x': 700, 'y': 'g', 'inner': {'k': 7}}),
        (8, 80,   4.5::DOUBLE,    {'x': 800, 'y': 'h', 'inner': {'k': 8}})
    ) AS t(id, v, f, s)
) TO '${WORK_DIR}/tf_0.vortex';
----
8

query I
COPY (
    SELECT * FROM (VALUES
        (101, 110, 10.0::DOUBLE, {'x': 1100, 'y': 'i', 'inner': {'k': 11}}),
        (102, 120, 20.0::DOUBLE, {'x': 1200, 'y': 'j', 'inner': {'k': 12}}),
        (103, 130, 30.0::DOUBLE, {'x': 1300, 'y': 'k', 'inner': {'k': 13}}),
        (104, 140, 40.0::DOUBLE, {'x': 1400, 'y': 'l', 'inner': {'k': 14}})
    ) AS t(id, v, f, s)
) TO '${WORK_DIR}/tf_1.vortex';
----
4

# Virtual column range, unsorted/duplicate IN, combined IN+range, and inequality filters.
query II
SELECT file_row_number, id FROM '${WORK_DIR}/tf_0.vortex'
WHERE file_row_number >= 2 AND file_row_number < 5
ORDER BY file_row_number;
----
2 3
3 4
4 5

query II
SELECT file_row_number, id FROM '${WORK_DIR}/tf_0.vortex'
WHERE file_row_number IN (6, 1, 4, 1, 6)
ORDER BY file_row_number;
----
1 2
4 5
6 7

query II
SELECT file_row_number, id FROM '${WORK_DIR}/tf_0.vortex'
WHERE file_row_number IN (0, 2, 4, 6, 7) AND file_row_number >= 2 AND file_row_number < 7
ORDER BY file_row_number;
----
2 3
4 5
6 7

# Multi-file filters combining file_index and file_row_number.
query III
SELECT file_index, file_row_number, id FROM '${WORK_DIR}/tf_*.vortex'
WHERE file_index = 1 AND file_row_number IN (3, 0, 2)
ORDER BY file_row_number;
----
1 0 101
1 2 103
1 3 104

# Regular column, conjunction (AND/OR), IS NULL, and struct-extract filters.
query I
SELECT id FROM '${WORK_DIR}/tf_0.vortex'
WHERE v IS NULL OR (id >= 5 AND s.x >= 600)
ORDER BY id;
----
2
5
6
7
8

query I
SELECT id FROM '${WORK_DIR}/tf_0.vortex'
WHERE (s.x IN (200, 400) AND s.y = 'd') OR (s.inner.k >= 6 AND s.inner.k <= 7) OR s.x IS NULL
ORDER BY id;
----
4
5
6
7

# Float filter with NaN and Inf (verifies ColumnStatistics NaN-max ordering matches DuckDB).
query I
SELECT id FROM '${WORK_DIR}/tf_0.vortex'
WHERE f > 3.5
ORDER BY id;
----
2
4
8
