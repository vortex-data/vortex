include ../setup.slt.no

# Statistics merged from the footers of several files prune filters that no file can match.

statement ok
COPY (SELECT * FROM (VALUES (1), (2), (3)) t(numbers)) TO '${WORK_DIR}/multi_stats_a.vortex';

statement ok
COPY (SELECT * FROM (VALUES (4), (5), (6)) t(numbers)) TO '${WORK_DIR}/multi_stats_b.vortex';

# Caches every footer.
query I
SELECT sum(numbers) FROM '${WORK_DIR}/multi_stats_*.vortex';
----
21

query TT
EXPLAIN SELECT numbers FROM '${WORK_DIR}/multi_stats_*.vortex' WHERE numbers > 6;
----
<REGEX>:.*EMPTY_RESULT.*

query TT
EXPLAIN SELECT numbers FROM '${WORK_DIR}/multi_stats_*.vortex' WHERE numbers > 5;
----
<!REGEX>:EMPTY_RESULT

# The statistics of the second file say that adding one overflows, so DuckDB keeps its overflow
# checks.

statement ok
COPY (SELECT * FROM (VALUES (1), (2), (3)) t(numbers)) TO '${WORK_DIR}/multi_overflow_a.vortex';

statement ok
COPY (SELECT * FROM (VALUES (2147483646), (2147483647)) t(numbers)) TO '${WORK_DIR}/multi_overflow_b.vortex';

query I
SELECT count(*) FROM '${WORK_DIR}/multi_overflow_*.vortex';
----
5

statement error Overflow
SELECT numbers + 1 FROM '${WORK_DIR}/multi_overflow_*.vortex';

# A first query over files no scan has opened plans with their statistics too, as planning reads
# the footers of local files.

statement ok
COPY (SELECT * FROM (VALUES (1), (2), (3)) t(numbers)) TO '${WORK_DIR}/multi_first_a.vortex';

statement ok
COPY (SELECT * FROM (VALUES (4), (5), (6)) t(numbers)) TO '${WORK_DIR}/multi_first_b.vortex';

query TT
EXPLAIN SELECT numbers FROM '${WORK_DIR}/multi_first_*.vortex' WHERE numbers > 6;
----
<REGEX>:.*EMPTY_RESULT.*
