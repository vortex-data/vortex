statement ok
COPY (SELECT range AS j FROM range(100000))
TO '${WORK_DIR}/copy_parallel.vortex';

query IIIII
SELECT count(*), sum(j), count(DISTINCT j), min(j), max(j) FROM '${WORK_DIR}/copy_parallel.vortex';
