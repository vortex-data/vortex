include ../setup.slt.no

query I
COPY (SELECT * FROM (VALUES (1), (2), (3), (4), (NULL)) t(number)) TO '${WORK_DIR}/members.vortex';
----
5

query I
SELECT count(*) FROM '${WORK_DIR}/members.vortex' WHERE number IN (1, 3);
----
2

query TT
EXPLAIN (FORMAT json) SELECT count(*) FROM '${WORK_DIR}/members.vortex' WHERE number IN (1, 3);
----
<!REGEX>:FILTER

query I
SELECT count(*) FROM '${WORK_DIR}/members.vortex' WHERE number NOT IN (1, 3);
----
2

query TT
EXPLAIN (FORMAT json) SELECT count(*) FROM '${WORK_DIR}/members.vortex' WHERE number NOT IN (1, 3);
----
<!REGEX>:FILTER

query I
SELECT count(*) FROM '${WORK_DIR}/members.vortex' WHERE number IN (1, NULL);
----
1

