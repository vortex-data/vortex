include ../setup.slt.no

query I
SELECT (SELECT count(*) FROM read_vortex('${WORK_DIR}/none_*.vortex', allow_empty=true)) +
       (SELECT count(*) FROM read_vortex('${WORK_DIR}/none_*.vortex', allow_empty=true));
----
0

statement ok
CREATE TABLE t(a INTEGER, b INTEGER);

statement ok
INSERT INTO t VALUES (1, 10), (2, 20), (3, 30), (4, 40), (5, 50);

statement ok
COPY t TO '${WORK_DIR}/cse.vortex';

query I
SELECT sum(a)::BIGINT FROM '${WORK_DIR}/cse.vortex' WHERE a > 2 OR b < 5
UNION ALL
SELECT sum(a)::BIGINT FROM '${WORK_DIR}/cse.vortex' WHERE a > 2 OR b < 5;
----
12
12

query TT
EXPLAIN SELECT sum(a)::BIGINT FROM '${WORK_DIR}/cse.vortex' WHERE a > 2 OR b < 5
UNION ALL
SELECT sum(a)::BIGINT FROM '${WORK_DIR}/cse.vortex' WHERE a > 2 OR b < 5;
