query I
SELECT sum(a)::BIGINT FROM '${WORK_DIR}/cse.vortex' WHERE a > 2 OR b < 5
UNION ALL
SELECT sum(a)::BIGINT FROM '${WORK_DIR}/cse.vortex' WHERE a > 2 OR b < 25
ORDER BY 1;
----
12
15

