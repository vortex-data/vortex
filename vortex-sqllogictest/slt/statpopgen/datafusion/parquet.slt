include ../../setup.slt.no

let FILE_FORMAT
SELECT 'parquet';

# The queries use DuckDB's `lambda x: ...` list-lambda syntax, which DataFusion
# only parses under its DuckDB SQL dialect, as in the vortex-bench suite.
statement ok
SET datafusion.sql_parser.dialect = 'duckdb';

include ./create.slt.no

# Most queries return the genotype lists of every variant, so results larger
# than this many values are compared by hash.
hash-threshold 100

include ../results/*.slt.no

hash-threshold 0

include ./drop.slt.no
