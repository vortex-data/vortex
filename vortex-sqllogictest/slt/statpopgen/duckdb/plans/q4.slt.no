query TT
EXPLAIN (FORMAT json)
SELECT "CHROM", "POS", "REF", "ALT", CAST(LIST_SUM("GT") AS DOUBLE) / (2 * LIST_SUM(LIST_TRANSFORM("GT", lambda g: g IS NOT NULL))) AS alternate_allele_frequency FROM statpopgen;
