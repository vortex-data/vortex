+/// Pack selected rows in their original domain, using a compact source for filtered execution.
+pub(crate) fn execute_bool_selected<Args, Prepared, Fail, const MULTIVERSIONED: bool, const FILTERED: bool>(
+    args: &dyn ExecutionArgs,
+    valid: &MaskValuesRef,
+    ctx: &mut ExecutionCtx,
+    prepare: impl FnOnce(Args::ConstElems<'_>) -> Prepared,
+    apply: impl Fn(&Prepared, Args::Elems<'_>) -> (bool, Fail),
+    finish_failure: impl FnOnce(Fail) -> VortexResult<()>,
+) -> VortexResult<Option<ArrayRef>>
+where
+    Args: IndexedElementTuple,
+    Fail: FailureEvidence,
+{
+    let columns = if FILTERED {
+        Args::decode(args, ctx)?
+    } else {
+        let Some(columns) = Args::decode_null_tolerant(args, ctx)? else { return Ok(None); };
+        columns
+    };
+    let row_count = args.row_count();
+    let expected = if FILTERED { valid.true_count() } else { valid.len() };
+    vortex_ensure!(row_count == expected, "selected input must address exactly {expected} rows, got {row_count}");
+    let Some(source) = decoded_source::<Args>(&columns, row_count) else {
+        vortex_bail!("a decoded row input does not address exactly {row_count} rows");
+    };
+    let prepared = prepare(Args::const_values(&columns));
+    let mut failure = Fail::default();
+    let mut indices = valid.bit_buffer().set_indices().peekable();
+    let mut filtered_index = 0;
+    let collect = |index| {
+        if indices.peek() != Some(&index) { return false; }
+        indices.next();
+        let input_index = if FILTERED { filtered_index } else { index };
+        filtered_index += 1;
+        // SAFETY: collectors visit indices in ascending order. The selected indices are below
+        // valid.len(), and their count is valid.true_count(). The source length checked above
+        // therefore covers either the original index or its compact rank.
+        let (value, row_failure) = apply(&prepared, unsafe { source.get_unchecked(input_index) });
+        failure |= row_failure;
+        value
+    };
+    let values = if MULTIVERSIONED {
+        BitBuffer::collect_bool_multiversioned(valid.len(), collect)
+    } else {
+        BitBuffer::collect_bool(valid.len(), collect)
+    };
+    finish_failure(failure)?;
+    Ok(Some(BoolArray::new(values, Validity::NonNullable).into_array()))
 }
