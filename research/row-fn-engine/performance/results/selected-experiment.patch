+#[rstest]
+#[case::empty(0)]
+#[case::one(1)]
+#[case::word_tail(63)]
+#[case::word(64)]
+#[case::word_remainder(65)]
+#[case::multiword(130)]
+fn test_deferred_bool_sliced_validity_and_constants(
+    #[case] len: usize,
+    #[values(false, true)] multiversioned: bool,
+    #[values(0, 1, 2)] constant_position: usize,
+    #[values(0, 1, 2)] validity_pattern: usize,
+) -> VortexResult<()> {
+    let valid = |index: usize| match validity_pattern {
+        0 => true,
+        1 => false,
+        _ => index % 3 != 0,
+    };
+    let validity = Validity::Array(
+        BoolArray::from_iter((0..len + 2).map(valid)).into_array(),
+    );
+    let varying = PrimitiveArray::new(
+        (0..len + 2).map(|index| if valid(index) { index as i64 } else { i64::MIN }).collect::<Vec<_>>(),
+        validity,
+    ).into_array().slice(1..len + 1);
+    let constant = ConstantArray::new(32_i64, len).into_array();
+    let other = PrimitiveArray::from_iter(std::iter::repeat_n(32_i64, len)).into_array();
+    let (lhs, rhs) = match constant_position {
+        1 => (constant, varying),
+        2 => (varying, constant),
+        _ => (varying, other),
+    };
+    let args = VecExecutionArgs::new(vec![lhs, rhs], len);
+    let mut ctx = array_session().create_execution_ctx();
+    let actual = if multiversioned {
+        execute_rows(&DeferredGreaterThan::<true>, &EmptyOptions, &args, &mut ctx)?
+    } else {
+        execute_rows(&DeferredGreaterThan::<false>, &EmptyOptions, &args, &mut ctx)?
+    };
+    let expected = BoolArray::from_iter((1..len + 1).map(|index| {
+        valid(index).then_some(if constant_position == 1 { 32 > index as i64 } else { index as i64 > 32 })
+    })).into_array();
+    assert_arrays_eq!(&actual, &expected, &mut ctx);
+    Ok(())
+}
