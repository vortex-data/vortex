+/// `libfoo-hash.early-rmeta` beside a `libfoo-hash.rmeta` or `.rlib` extern, if it exists.
+fn early_metadata_path(extern_path: &Path) -> PathBuf {
+    match extern_path.extension().and_then(|e| e.to_str()) {
+        Some("rmeta" | "rlib") => {
+            let early = extern_path.with_extension("early-rmeta");
+            if early.exists() {
+                early
+            } else {
+                extern_path.to_owned()
+            }
+        }
+        _ => extern_path.to_owned(),
+    }
+}
