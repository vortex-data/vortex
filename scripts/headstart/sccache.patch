+/// Set when a client-side compile should pass the compiler's stderr through as it arrives.
+pub static STREAM_COMPILER_STDERR: std::sync::atomic::AtomicBool =
+    std::sync::atomic::AtomicBool::new(false);
+/// Set once a compiler's stderr has been streamed, so it isn't written again from the result.
+pub static COMPILER_STDERR_STREAMED: std::sync::atomic::AtomicBool =
+    std::sync::atomic::AtomicBool::new(false);
+
+/// Like `run_input_output`, but also copies the child's stderr to this process's stderr as it
+/// arrives. A build tool that acts on the compiler's messages before it exits, such as Cargo
+/// with headstart, needs to see them while it runs.
+pub async fn run_input_output_streaming_stderr<C>(mut command: C) -> Result<process::Output>
+where
+    C: RunCommand,
+{
+    use std::sync::atomic::Ordering;
+    use tokio::io::AsyncReadExt;
+    let mut child = command
+        .stdin(Stdio::inherit())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .await?;
+    let stdout = child.take_stdout();
+    let stdout = async move {
+        let mut buf = Vec::new();
+        if let Some(mut stdout) = stdout {
+            stdout
+                .read_to_end(&mut buf)
+                .await
+                .context("failed to read stdout")?;
+        }
+        Result::Ok(buf)
+    };
+    let stderr = child.take_stderr();
+    let stderr = async move {
+        let mut buf = Vec::new();
+        if let Some(mut stderr) = stderr {
+            let mut chunk = [0u8; 8192];
+            loop {
+                let n = stderr
+                    .read(&mut chunk)
+                    .await
+                    .context("failed to read stderr")?;
+                if n == 0 {
+                    break;
+                }
+                let mut out = std::io::stderr().lock();
+                out.write_all(&chunk[..n])?;
+                out.flush()?;
+                buf.extend_from_slice(&chunk[..n]);
+            }
+        }
+        Result::Ok(buf)
+    };
+    let (stdout, stderr) = futures::try_join!(stdout, stderr)?;
+    let status = child.wait().await.context("failed to wait for child")?;
+    COMPILER_STDERR_STREAMED.store(true, Ordering::SeqCst);
+    let output = process::Output {
+        status,
+        stdout,
+        stderr,
+    };
+    if output.status.success() {
+        Ok(output)
+    } else {
+        Err(ProcessError(output).into())
+    }
+}
