{
  "name": "vortex-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "wasm": "wasm-pack build crate --dev --target web --out-dir ../src/wasm/pkg",
    "wasm:release": "wasm-pack build crate --profile wasm_release --target web --out-dir ../src/wasm/pkg",
    "dev": "bun run wasm && vite",
    "build": "bun run wasm:release && tsc -b && vite build",
    "check": "bun run wasm && biome check && bun run typecheck",
    "preview": "vite preview",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "typecheck": "tsc -b --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.23",
    "apache-arrow": "^21.2.0",
    "d3-hierarchy": "^3.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "storybook": "^10.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "trustedDependencies": []
}
