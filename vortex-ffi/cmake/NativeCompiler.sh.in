#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# SPDX-FileCopyrightText: Copyright the Vortex contributors

# Mandatory compiler arguments also apply to compiler-family and flag probes.
set -- @_compiler_command@ "$@"
# Build tools stay uninstrumented: the Rust linker is host-only, and Cargo
# clears Rust flags for host build-tool dependencies under --target.
if @rust_linker@ || [ -z "${CARGO_ENCODED_RUSTFLAGS:-}" ]; then
    for arg do
        shift
        case "$arg" in
            -fsanitize=*|-fsanitize-coverage=*|--coverage|-fprofile-arcs|-ftest-coverage) ;;
            -fprofile-instr-generate|-fprofile-instr-generate=*|-fcoverage-mapping) ;;
            -fprofile-generate|-fprofile-generate=*) ;;
            *) set -- "$@" "$arg" ;;
        esac
    done
fi
# Match cc-rs's native-compatible Rust wrappers, but cache AFTER filtering.
if @_use_rustc_wrapper@; then
    wrapper_name=${RUSTC_WRAPPER##*/}
    case "${wrapper_name%.*}" in
        sccache|cachepot|buildcache|kache) set -- "$RUSTC_WRAPPER" "$@" ;;
    esac
fi
# Linker flags are empty for native compilation; otherwise the selection wins last.
exec "$@" @_linker_flags@
